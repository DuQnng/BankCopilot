create table tlias.account
(
    id           bigint auto_increment comment '账户ID'
        primary key,
    user_id      bigint                                   not null comment '用户ID，对应登录用户',
    account_no   varchar(32)                              not null comment '账户号',
    account_type varchar(20)    default '储蓄卡'          null comment '账户类型',
    balance      decimal(12, 2) default 0.00              null comment '账户余额',
    status       varchar(10)    default '正常'            null comment '账户状态',
    create_time  datetime       default CURRENT_TIMESTAMP null comment '创建时间',
    update_time  datetime       default CURRENT_TIMESTAMP null on update CURRENT_TIMESTAMP comment '更新时间'
)
    comment '银行账户表' row_format = DYNAMIC;

create table tlias.bank_product
(
    id            bigint auto_increment comment '产品ID'
        primary key,
    name          varchar(50)                        null comment '产品名称',
    type          varchar(20)                        null comment '产品类型（贷款/信用卡/理财）',
    description   text                               null comment '产品介绍',
    interest_rate decimal(5, 2)                      null comment '利率（可选）',
    create_time   datetime default CURRENT_TIMESTAMP null
)
    comment '银行产品/业务说明表' row_format = DYNAMIC;

create table tlias.payee_contact
(
    id          bigint auto_increment comment '主键'
        primary key,
    user_id     bigint                             not null comment '所属用户ID',
    payee_name  varchar(64)                        not null comment '收款人姓名',
    account_no  varchar(32)                        not null comment '收款人银行卡号',
    alias       varchar(64)                        null comment '备注/昵称',
    create_time datetime default CURRENT_TIMESTAMP not null comment '创建时间',
    update_time datetime default CURRENT_TIMESTAMP not null on update CURRENT_TIMESTAMP comment '更新时间',
    constraint uk_user_account_no
        unique (user_id, account_no)
)
    comment '常用收款人表';

create index idx_user_id
    on tlias.payee_contact (user_id);

create table tlias.transaction_record
(
    id                      bigint auto_increment
        primary key,
    account_id              bigint                             not null,
    counterparty_account_no varchar(20)                        null,
    type                    varchar(10)                        not null,
    amount                  decimal(12, 2)                     not null,
    description             varchar(255)                       null,
    trade_time              datetime default CURRENT_TIMESTAMP null
)
    row_format = DYNAMIC;

create table tlias.user
(
    id          int unsigned auto_increment comment 'ID'
        primary key,
    username    varchar(20)                  not null comment '用户名',
    password    varchar(32) default '123456' null comment '密码',
    create_time datetime                     not null comment '创建时间',
    update_time datetime                     not null comment '修改时间',
    phone       varchar(20)                  not null comment '手机号',
    name        varchar(32)                  not null,
    constraint username
        unique (username)
)
    comment '员工表' row_format = DYNAMIC;

