        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;取消/超时分支&lt;/b&gt;&lt;br/&gt;用户回复“取消”或待确认状态超过 10 分钟时，pendingMap 被清理，资金操作不会执行。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacing=8;fontFamily=Songti SC,Times New Roman;fontSize=12;" parent="1" vertex="1">
