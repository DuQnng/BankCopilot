        <mxCell id="note1" value="&lt;b&gt;安全约束&lt;/b&gt;&lt;br/&gt;第一次自然语言转账请求不会直接扣款，只生成脱敏确认信息并写入 pendingMap。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacing=8;fontFamily=Songti SC,Times New Roman;fontSize=12;" parent="1" vertex="1">
