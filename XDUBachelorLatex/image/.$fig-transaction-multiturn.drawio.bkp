        <mxCell id="note1" value="&lt;b&gt;条件判断&lt;/b&gt;&lt;br/&gt;needMonth=true 且 day 不为空且 month 为空时，才进入多轮补全。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacing=8;fontFamily=Songti SC,Times New Roman;fontSize=12;" parent="1" vertex="1">
