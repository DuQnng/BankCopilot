        <mxCell id="note1" value="&lt;b&gt;与流水查询的关系&lt;/b&gt;&lt;br/&gt;统计分析以 transaction_record 流水数据为基础，是“自然语言流水查询”的聚合分析扩展；图中重点展示数据处理管线，因此采用流程图而非时序图。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1.1;shadow=0;align=left;verticalAlign=middle;spacing=8;fontFamily=Songti SC,Times New Roman;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="760" y="520" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;反幻觉约束&lt;/b&gt;&lt;br/&gt;大模型只基于后端 facts 生成表达，不直接计算金额；不支持消费品类、商户类型和场景标签分析。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1.1;shadow=0;align=left;verticalAlign=middle;spacing=8;fontFamily=Songti SC,Times New Roman;fontSize=13;" parent="1" vertex="1">
